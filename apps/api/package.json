{
  "name": "@recover-ai/api",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "npx --no-install tsx watch src/index.ts",
    "build": "npx --no-install tsc",
    "start": "node dist/index.js",
    "db:format": "npx --no-install prisma format",
    "db:validate": "npx --no-install prisma validate",
    "db:generate": "npx --no-install prisma generate",
    "db:migrate": "npx --no-install prisma migrate dev",
    "db:seed": "npx --no-install tsx prisma/seed.ts"
  },
  "dependencies": {
    "@google/genai": "^2.18.0",
    "@prisma/client": "^5.14.0",
    "@recover-ai/shared": "*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@types/supertest": "^6.0.2",
    "prisma": "^5.14.0",
    "supertest": "^7.0.0",
    "tsx": "^4.9.3",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
