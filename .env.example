# APPLICATION
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# DATABASE (PostgreSQL 16)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/recover_ai_db?schema=public"

# REDIS (Redis 7)
REDIS_URL="redis://localhost:6379"

# AI SERVICE (Defaults to Mock Mode - $0 Cost)
AI_MODE="mock"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# RAZORPAY TEST-MODE KEYS
RAZORPAY_KEY_ID="rzp_test_your_key_id_placeholder"
RAZORPAY_KEY_SECRET="your_razorpay_test_secret_placeholder"
RAZORPAY_WEBHOOK_SECRET="whsec_your_razorpay_webhook_secret_placeholder"

# POLICY BOUNDS
POLICY_MAX_DISCOUNT_PERCENT=5.0
POLICY_MAX_RETRIES=3
POLICY_DND_START_HOUR=9
POLICY_DND_END_HOUR=20
